rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/history/{entryId} {
      allow read, delete: if request.auth != null
        && request.auth.uid == userId
        && entryId == "current";

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && entryId == "current"
        && request.resource.data.keys().hasOnly(["schemaVersion", "entries", "updatedAt"])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.entries is list
        && request.resource.data.entries.size() <= 500
        && request.resource.data.updatedAt is timestamp;
    }

    match /users/{userId}/profile/{profileId} {
      allow read, delete: if request.auth != null
        && request.auth.uid == userId
        && profileId == "current";

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && profileId == "current"
        && request.resource.data.keys().hasOnly(["schemaVersion", "displayName", "updatedAt"])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.displayName is string
        && request.resource.data.displayName.matches("^[A-Za-z0-9_-]{3,20}$")
        && request.resource.data.updatedAt == request.time;
    }

    match /users/{userId}/membership/{membershipId} {
      allow read: if request.auth != null
        && request.auth.uid == userId
        && membershipId == "current";
      allow create, update, delete: if false;
    }

    match /trainingAggregates/{scenarioId} {
      allow read, write: if false;
    }

    match /trainingReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
